#: forms.py:385
msgid "Attach File"
msgstr "Joindre un fichier"

#: forms.py:387
msgid ""
"You can attach a file to this ticket. Only file types such as plain text "
"(.txt), a document (.pdf, .docx, or .odt), or screenshot (.png or .jpg) may "
"be uploaded."
msgstr ""
"Vous pouvez attacher un fichier à ce ticket. Seuls les fichiers texte "
"(.txt), documents (.pdf, .docx, ou .odt), ou capture d'écran (.png ou .jpg) "
"peuvent être mis en ligne."

#: forms.py:404
msgid "Knowledge Base Item"
msgstr "Article de la base de connaissances"

#: forms.py:511
msgid "Submitter E-Mail Address"
msgstr "Adresse e-mail de l'émetteur"

#: forms.py:514
msgid ""
"This e-mail address will receive copies of all public updates to this "
"ticket."
msgstr ""
"Cette adresse e-mail recevra des copies de toutes les mises à jour publiques"
" de ce ticket."

#: forms.py:525
msgid "Case owner"
msgstr "Propriétaire"

#: forms.py:527
msgid ""
"If you select an owner other than yourself, they'll be e-mailed details of "
"this ticket immediately."
msgstr ""
"Si vous sélectionnez un autre propriétaire que vous-même, il lui sera "
"immédiatement envoyé par courriel les détails de ce billet."

#: forms.py:578
#, python-format
msgid "Ticket Opened & Assigned to %(name)s"
msgstr "Billet ouvert et assigné à %(name)s"

#: forms.py:579
msgid "<invalid user>"
msgstr "<utilisateur invalide>"

#: forms.py:582
msgid "Ticket Opened"
msgstr "Billet ouvert"

#: forms.py:611
msgid "Your E-Mail Address"
msgstr "Votre adresse e-mail"

#: forms.py:612
msgid "We will e-mail you when your ticket is updated."
msgstr "Nous vous enverrons un e-mail dès que votre billet sera mis à jour."

#: forms.py:683
msgid "Ticket Opened Via Web"
msgstr "Billet ouvert via le Web"

#: forms.py:814
msgid "Tickets to merge"
msgstr "Billet à fusionner"

#: forms.py:838
msgid "Please choose at least 2 tickets."
msgstr "Veuillez choisir au moins 2 tickets"

#: forms.py:840
msgid "Impossible to merge more than 4 tickets..."
msgstr "Impossible de fusionner plus de 4 tickets..."

#: forms.py:845
msgid "All selected tickets must share the same queue in order to be merged."
msgstr ""
"Tous les tickets sélectionnés doivent partager la même file afin d'être "
"fusionnés"

#: forms.py:880
msgid "Template"
msgstr "Template"

